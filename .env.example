# China ThinkingData account
TA_URL_CN=https://your-ta-china-url.com/
TA_USER_CN=your_username
TA_PASS_CN=your_password

# International ThinkingData account
TA_URL_GLOBAL=https://your-ta-global-url.com/
TA_USER_GLOBAL=your_username
TA_PASS_GLOBAL=your_password

# Optional: add hostname aliases when automatic URL-region detection needs them.
# TA_CN_HOSTS=ss-web.5xgames.com
# TA_GLOBAL_HOSTS=your-ta-global-url.com

# Browser sessions are kept separately for the two instances.
USER_DATA_DIR=./ta_session
